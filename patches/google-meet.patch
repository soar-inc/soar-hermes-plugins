diff --git a/plugins/google_meet/wake_caption.py b/plugins/google_meet/wake_caption.py
new file mode 100644
index 0000000..498af49
--- /dev/null
+++ b/plugins/google_meet/wake_caption.py
@@ -0,0 +1,155 @@
+"""Answer opt-in wake questions collected from live Google Meet captions."""
+
+from __future__ import annotations
+
+import re
+import threading
+from pathlib import Path
+from queue import Empty, SimpleQueue
+
+_PUNCTUATION = " ,.!?;:—–-"
+
+
+def _answer(question: str) -> str:
+    from agent.auxiliary_client import call_llm
+    from agent.secret_scope import build_profile_secret_scope, reset_secret_scope, set_secret_scope
+    from hermes_cli.config import load_config
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+    from hermes_constants import get_hermes_home
+
+    home = Path(get_hermes_home())
+    token = set_secret_scope(build_profile_secret_scope(home), profile_home=str(home))
+    try:
+        model_config = load_config().get("model")
+        model = model_config.get("default") if isinstance(model_config, dict) else model_config
+        runtime = resolve_runtime_provider(target_model=model)
+        response = call_llm(
+            task="meet_wake",
+            provider=runtime["provider"],
+            model=model,
+            base_url=runtime.get("base_url"),
+            api_key=runtime.get("api_key"),
+            api_mode=runtime.get("api_mode"),
+            main_runtime=runtime,
+            timeout=20,
+            messages=[
+                {"role": "system", "content": "Answer the meeting attendee in one short spoken sentence. "
+                 "Use general knowledge. Do not repeat the wake phrase."},
+                {"role": "user", "content": question},
+            ],
+        )
+        return " ".join((response.choices[0].message.content or "").split())[:650]
+    finally:
+        reset_secret_scope(token)
+
+
+class CaptionWake:
+    def __init__(self, bot_name: str, out_dir: Path, *, wake_session: str | None = None,
+                 wake_name: str | None = None, wake_aliases: tuple[str, ...] = ()) -> None:
+        word = wake_name
+        if word is None:
+            from hermes_cli.config import load_config_readonly
+
+            options = load_config_readonly().get("plugins", {}).get("entries", {}).get("google_meet", {})
+            word = options.get("wake_word", "Horizon")
+            aliases = options.get("wake_aliases", [])
+            if isinstance(aliases, list):
+                wake_aliases = (*wake_aliases, *aliases)
+        if not isinstance(word, str) or not word.isalpha():
+            word = "Horizon"
+        words = [word]
+        words.extend(alias for alias in wake_aliases if isinstance(alias, str) and alias.isalpha())
+        alternatives = "|".join(re.escape(word) for word in words)
+        self._wake = re.compile(rf"\bhey[\s,.:!?—–-]+(?:{alternatives})\b", re.IGNORECASE)
+        self._split_wake = re.compile(rf"(?:{alternatives})\b", re.IGNORECASE)
+        self._bot_names = {bot_name.strip().casefold(), "you"} - {""}
+        self._queue_path = out_dir / "say_queue.jsonl"
+        self._wake_session = wake_session
+        self._speaker: str | None = None
+        self._parts: dict[int, str] = {}
+        self._marker_row = -1
+        self._last: tuple[str, int, str, float] | None = None
+        self._updated = 0.0
+        self._working = False
+        self._results: SimpleQueue[tuple[str, str | None]] = SimpleQueue()
+
+    def observe(self, entry: dict, now: float) -> None:
+        row = entry.get("row")
+        text = " ".join(str(entry.get("text", "")).split())
+        speaker = str(entry.get("speaker", "")).strip().casefold()
+        if not isinstance(row, int) or not text or speaker in self._bot_names or speaker.endswith(" (you)"):
+            return
+
+        matches = list(self._wake.finditer(text))
+        previous = " ".join(str(entry.get("previous", "")).split())
+        fresh = len(matches) > len(list(self._wake.finditer(previous)))
+        after_wake = text[matches[-1].end():].lstrip(_PUNCTUATION) if matches else ""
+        # Captions can split the two wake words across adjacent rows.
+        if not matches and self._last is not None:
+            last_speaker, last_row, last_text, last_at = self._last
+            split = self._split_wake.match(text)
+            if (split and row > last_row and speaker == last_speaker and now - last_at < 3
+                    and re.search(r"\bhey[,.:!?]?$", last_text, re.IGNORECASE)):
+                fresh = True
+                after_wake = text[split.end():].lstrip(_PUNCTUATION)
+        self._last = (speaker, row, text, now)
+
+        if fresh:
+            self._speaker, self._marker_row = speaker, row
+            self._parts = {row: after_wake}
+            self._updated = now
+        elif self._speaker == speaker and row >= self._marker_row and now - self._updated < 6:
+            if row == self._marker_row:
+                if matches:
+                    self._parts[row] = after_wake
+                elif (split := self._split_wake.match(text)):
+                    self._parts[row] = text[split.end():].lstrip(_PUNCTUATION)
+                else:
+                    return
+            elif not matches:
+                self._parts[row] = text
+            else:
+                return
+            self._updated = now
+
+    def poll(self, state, now: float) -> None:
+        if self._working:
+            try:
+                answer, error = self._results.get_nowait()
+            except Empty:
+                return
+            self._working = False
+            if answer:
+                from plugins.google_meet.process_manager import append_say
+                try:
+                    append_say(self._queue_path, answer)
+                except (OSError, TimeoutError):
+                    error = "Could not queue the spoken response."
+            state.set(wake_error=error)
+
+        if self._speaker is None:
+            return
+        question = " ".join(part for _, part in sorted(self._parts.items()) if part)[:500]
+        if now - self._updated < (2 if question else 6):
+            return
+        self._speaker, self._parts = None, {}
+        if not question:
+            return
+        state.set(wake_questions=state.wake_questions + 1, wake_error=None)
+        self._working = True
+        threading.Thread(target=self._answer, args=(question,), name="meet-wake", daemon=True).start()
+
+    def _answer(self, question: str) -> None:
+        try:
+            if self._wake_session:
+                from plugins.google_meet.wake_chat import answer_in_chat
+
+                answer = answer_in_chat(self._wake_session, question)
+            else:
+                answer = _answer(question)
+            self._results.put((answer, None if answer else "The profile model returned an empty answer."))
+        except Exception as exc:
+            from plugins.google_meet.wake_chat import WakeChatError
+
+            error = str(exc) if isinstance(exc, WakeChatError) else f"Profile model request failed ({type(exc).__name__})."
+            self._results.put(("", error))
diff --git a/plugins/google_meet/wake_chat.py b/plugins/google_meet/wake_chat.py
new file mode 100644
index 0000000..962d851
--- /dev/null
+++ b/plugins/google_meet/wake_chat.py
@@ -0,0 +1,228 @@
+"""Route an explicitly selected meeting to a read-only FlowMind chat session."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import subprocess
+import uuid
+from pathlib import Path
+
+_SESSION_ID = re.compile(r"(?:local-[a-f0-9]{64}|\d{8}_\d{6}_[a-f0-9]{6,12})")
+_FLOWMIND_TOOLS = {"list_projects", "list_tickets", "count_tickets", "get_ticket"}
+
+
+class WakeChatError(RuntimeError):
+    """A wake-chat error safe to expose in Meet status."""
+
+
+def _meeting_chat_path(url: str) -> Path | None:
+    from hermes_constants import get_hermes_home
+    from plugins.google_meet.meet_bot import MEET_URL_RE
+
+    match = MEET_URL_RE.fullmatch(url.strip())
+    code = match.group(1) if match else ""
+    if not code or code == "new" or "/" in code:
+        return None
+    return Path(get_hermes_home()) / "workspace" / "meetings" / code / "wake-chat.json"
+
+
+def load_meeting_chat(url: str) -> str:
+    path = _meeting_chat_path(url)
+    if path is None:
+        raise ValueError("--resume-wake-chat needs a Meet link containing a meeting code")
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+    except FileNotFoundError as exc:
+        raise ValueError("No chat saved for this Meet code. Join once with --wake-session SESSION_ID.") from exc
+    except (OSError, ValueError) as exc:
+        raise ValueError("Could not read the chat saved for this Meet code.") from exc
+    session_id = value.get("session_id") if isinstance(value, dict) else None
+    if not isinstance(session_id, str) or not _SESSION_ID.fullmatch(session_id):
+        raise ValueError("The saved chat ID is invalid. Join with --wake-session SESSION_ID to replace it.")
+    return session_id
+
+
+def remember_meeting_chat(url: str, session_id: str) -> None:
+    from utils import atomic_json_write
+
+    path = _meeting_chat_path(url)
+    if path is not None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        atomic_json_write(path, {"session_id": session_id}, mode=0o600)
+
+
+def validate_wake_chat(session_id: str) -> None:
+    if not _SESSION_ID.fullmatch(session_id):
+        raise ValueError("--wake-session requires the ID of a dedicated Hermes chat")
+    _validate_flowmind()
+
+
+def _validate_flowmind() -> None:
+    from hermes_cli.config_effective import load_user_config_effective
+    from hermes_constants import get_hermes_home
+
+    config = load_user_config_effective(Path(get_hermes_home()) / "config.yaml")
+    servers = config.get("mcp_servers")
+    server = servers.get("flowmind") if isinstance(servers, dict) else None
+    if not isinstance(server, dict) or "mcp-flowmind" in servers:
+        raise ValueError("Enable the existing FlowMind MCP server named flowmind in this profile.")
+    context = config.get("context") or {}
+    if str(context.get("engine") or "compressor").strip().lower() != "compressor":
+        raise ValueError("Wake chat requires the default context engine to keep tool access restricted.")
+    tools = server.get("tools")
+    include = tools.get("include") if isinstance(tools, dict) else None
+    url = server.get("url")
+    if (not isinstance(url, str) or url.rstrip("/") != "https://build.soar.inc/api/agent/mcp"
+            or server.get("enabled") is False or server.get("disabled") is True
+            or not isinstance(include, list) or not include
+            or any(not isinstance(tool, str) or tool not in _FLOWMIND_TOOLS for tool in include)
+            or tools.get("resources") is not False or tools.get("prompts") is not False):
+        raise ValueError("Configure enabled flowmind with an explicit read-only tool list and disable resources and prompts.")
+
+
+def answer_in_chat(session_id: str, question: str) -> str:
+    from hermes_constants import get_hermes_home
+
+    try:
+        validate_wake_chat(session_id)
+    except ValueError as exc:
+        raise WakeChatError(str(exc)) from exc
+    if question.lstrip().startswith("/"):
+        raise WakeChatError("A spoken question cannot run a Hermes slash command.")
+
+    launcher = Path.home() / ".local" / "bin" / "hermes"
+    env = {**os.environ, "HERMES_HOME": str(get_hermes_home())}
+    env.pop("HERMES_MEET_REALTIME_KEY", None)
+    try:
+        # The gateway validates the repeated flags against the session's original launch
+        # policy. A normal chat with a broader toolset therefore cannot be used here.
+        result = subprocess.run(
+            [str(launcher), "chat", "--resume", session_id, "--ignore-rules",
+             "--toolsets", "mcp-flowmind", "--format", "stream-json", "--query-file", "-"],
+            input=question, capture_output=True, text=True, timeout=75, env=env,
+        )
+    except subprocess.TimeoutExpired as exc:
+        raise WakeChatError("The Hermes chat took too long. Check its history before repeating the question.") from exc
+    except OSError as exc:
+        raise WakeChatError("Could not start the Hermes chat client.") from exc
+
+    if result.returncode:
+        raise WakeChatError("Hermes chat failed. Check the dedicated session ID, launch flags, and FlowMind connection.")
+    for line in reversed(result.stdout.splitlines()):
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if isinstance(event, dict) and event.get("type") == "result":
+            reply = event.get("text")
+            if not event.get("exit_code") and isinstance(reply, str) and reply.strip():
+                return " ".join(reply.split())[:650]
+            break
+    raise WakeChatError("Hermes chat returned no reply.")
+
+
+def _calendar_title(raw_title, suffix=""):
+    from hermes_state import SessionDB
+
+    name, separator, date = raw_title.rpartition(" · ")
+    tail = f"{separator}{date}{suffix}" if separator else suffix
+    budget = SessionDB.MAX_TITLE_LENGTH - len(tail)
+    name = name if separator else raw_title
+    if len(name) > budget:
+        name = name[:budget - 1].rstrip() + "…"
+    return SessionDB.sanitize_title(name + tail)
+
+
+async def _name_calendar_chat(client, snapshot, raw_title, event_key):
+    session_id = snapshot["stored_session_id"]
+    for suffix in ("", f" · {event_key[:8]}"):
+        title = _calendar_title(raw_title, suffix)
+        existing = await client.rpc("session.list", title=title, limit=1)
+        sessions = existing.get("sessions", [])
+        if sessions:
+            if sessions[0].get("session_id") == session_id:
+                return
+            continue
+        await client.rpc(
+            "session.mutate", session_id=session_id, request_id=uuid.uuid4().hex,
+            expected_revision=snapshot["revision"], operation="rename", payload={"title": title},
+        )
+        return
+    raise WakeChatError("Calendar chat title is already in use.")
+
+
+async def calendar_chat_session(event_key: str, raw_title: str | None = None, generation: int = 0
+                                ) -> tuple[str, str | None, int]:
+    from argparse import Namespace
+    from hermes_cli.gateway_chat import check_resume_policy
+    from hermes_cli.gateway_client import GatewayClientError, GatewayRPCError, connect_gateway
+
+    if not re.fullmatch(r"[a-f0-9]{64}", event_key):
+        raise ValueError("Invalid Calendar event key.")
+    if generation < 0:
+        raise ValueError("Invalid Calendar chat generation.")
+    _validate_flowmind()
+    async with connect_gateway() as client:
+        for candidate in range(generation, generation + 8):
+            request_id = event_key
+            if candidate:
+                request_id = hashlib.sha256(f"{event_key}:replacement:{candidate}".encode()).hexdigest()
+            try:
+                snapshot = await client.rpc(
+                    "session.create",
+                    request_id=request_id[:32],
+                    source="cli",
+                    ignore_rules=True,
+                    toolsets=["mcp-flowmind"],
+                )
+                break
+            except GatewayRPCError as exc:
+                # A deleted session keeps its original request ID retired.
+                if str(exc) != "not_found":
+                    raise
+        else:
+            raise WakeChatError("Could not find a reusable Calendar chat after deleted sessions.")
+        # The stable request resolves a replacement even if the watcher stopped before saving it.
+        check_resume_policy(Namespace(ignore_rules=True, toolsets="mcp-flowmind"), snapshot)
+        session_id = snapshot.get("stored_session_id")
+        if not isinstance(session_id, str) or not _SESSION_ID.fullmatch(session_id):
+            raise WakeChatError("Hermes did not return a usable Calendar chat session ID.")
+        try:
+            await _name_calendar_chat(
+                client, snapshot, raw_title or f"Hey Horizon Calendar {event_key[:24]}", event_key,
+            )
+        except (GatewayClientError, WakeChatError, ValueError):
+            return session_id, "Could not update the Calendar chat title. The existing chat will still be used.", candidate
+    return session_id, None, candidate
+
+
+def main() -> int:
+    import argparse
+    import asyncio
+    import sys
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--calendar-event-key", required=True)
+    parser.add_argument("--title-from-stdin", action="store_true")
+    parser.add_argument("--calendar-chat-generation", type=int, default=0)
+    args = parser.parse_args()
+    raw_title = sys.stdin.read(1024) if args.title_from_stdin else None
+    try:
+        session_id, title_warning, generation = asyncio.run(
+            calendar_chat_session(args.calendar_event_key, raw_title, args.calendar_chat_generation)
+        )
+    except (ValueError, WakeChatError) as exc:
+        print(json.dumps({"ok": False, "error": str(exc)}))
+        return 1
+    except Exception:
+        print(json.dumps({"ok": False, "error": "Could not create or resume the Bot's Calendar chat."}))
+        return 1
+    print(json.dumps({"ok": True, "session_id": session_id, "title_warning": title_warning, "generation": generation}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
